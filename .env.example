# Paperclip — local development environment (optional)
# Copy to .env only if you need to override defaults.
# For embedded Postgres (default): leave DATABASE_URL UNSET in your shell
# (a global Neon DATABASE_URL will break local embedded DB with "Tenant or user not found").
#
# See also: doc/DEVELOPING.md, AGENTS.md § Dev Setup

# --- Server ---
PORT=3100
HOST=127.0.0.1
# Public URL when behind proxy / tunnel (staging)
# PAPERCLIP_PUBLIC_URL=http://127.0.0.1:3100

# --- Database ---
# Optional: external Postgres. Omit for embedded Postgres (~/.paperclip/...).
# DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip

# --- Instance paths (override defaults) ---
# PAPERCLIP_HOME=
# PAPERCLIP_INSTANCE_ID=default
# PAPERCLIP_CONFIG=/absolute/path/to/config.json

# --- Secrets & JWT ---
# PAPERCLIP_AGENT_JWT_SECRET=
# PAPERCLIP_SECRETS_STRICT_MODE=false

# --- Storage (override file config) ---
# PAPERCLIP_STORAGE_PROVIDER=local_disk
# PAPERCLIP_STORAGE_LOCAL_DIR=
# PAPERCLIP_STORAGE_S3_BUCKET=
# PAPERCLIP_STORAGE_S3_REGION=

# --- Deployment / auth (override file config) ---
# PAPERCLIP_DEPLOYMENT_MODE=local_trusted
# PAPERCLIP_DEPLOYMENT_EXPOSURE=private
# PAPERCLIP_AUTH_BASE_URL_MODE=auto
# PAPERCLIP_AUTH_DISABLE_SIGN_UP=false
# PAPERCLIP_ALLOWED_HOSTNAMES=

# --- OpenClaw gateway (openclaw_gateway adapter) ---
# Default WebSocket URL for API-created agents when adapterConfig.url is empty (server-side).
# Local dev: omit or use ws://127.0.0.1:18789
# Paperclip in Docker, OpenClaw on host (Docker Desktop): ws://host.docker.internal:18789
# PAPERCLIP_DEFAULT_OPENCLAW_GATEWAY_WS_URL=ws://host.docker.internal:18789

# --- Integrations (Paperclip server features) ---
MISSION_CONTROL_URL=http://127.0.0.1:3000
PAPERCLIP_API_URL=http://127.0.0.1:3100
CREWAI_WEBHOOK_URL=http://127.0.0.1:8000/webhook
LANGGRAPH_WEBHOOK_URL=http://127.0.0.1:8001/webhook

# --- Attachments ---
# PAPERCLIP_ALLOWED_ATTACHMENT_TYPES=
# PAPERCLIP_ATTACHMENT_MAX_BYTES=

# --- UI ---
SERVE_UI=false
